{
  "services": {
    "seed": {
      "build": {
        "context": ".",
        "dockerfile": "previews/Dockerfile.seed"
      },
      "environment": {
        "PREVIEW_ENVIRONMENT": "${PREVIEW_ENVIRONMENT}",
        "PREVIEW_MONGO_ADMIN_URI": "${PREVIEW_MONGO_ADMIN_URI}",
        "SEED_SOURCES_JSON": "${SEED_SOURCES_JSON}",
        "PREVIEW_DATABASE_CREDENTIALS_JSON": "${PREVIEW_DATABASE_CREDENTIALS_JSON}"
      },
      "restart": "no",
      "mem_limit": "256m",
      "cpus": 0.5,
      "networks": [
        "preview",
        "coolify"
      ]
    },
    "auth": {
      "build": {
        "context": "https://github.com/leia-org/leia-auth.git#${AUTH_COMMIT}",
        "dockerfile_inline": "FROM node:22-bookworm-slim\nWORKDIR /app\nCOPY . .\nRUN npm ci --omit=dev && npm cache clean --force\nEXPOSE 3000\nCMD [\"node\", \"-e\", \"Object.assign(process.env, JSON.parse(process.env.APP_CONFIG_JSON)); delete process.env.APP_CONFIG_JSON; import('./src/index.js')\"]\n"
      },
      "environment": {
        "APP_CONFIG_JSON": "${AUTH_CONFIG_JSON}"
      },
      "restart": "unless-stopped",
      "mem_limit": "384m",
      "cpus": 0.5,
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/', {method:'OPTIONS'}).then(r=>process.exit(r.status===204?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "5s",
        "timeout": "3s",
        "start_period": "20s",
        "retries": 20
      },
      "labels": [
        "traefik.enable=true",
        "traefik.docker.network=coolify",
        "traefik.http.services.leia-${PREVIEW_ENVIRONMENT}-auth.loadbalancer.server.port=3000",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-auth-http.rule=Host(`${AUTH_HOST}`)",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-auth-http.entrypoints=http",
        "traefik.http.middlewares.leia-${PREVIEW_ENVIRONMENT}-auth-redirect.redirectscheme.scheme=${PREVIEW_HTTP_SCHEME}",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-auth-http.middlewares=leia-${PREVIEW_ENVIRONMENT}-auth-redirect",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-auth-http.service=leia-${PREVIEW_ENVIRONMENT}-auth",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-auth-https.rule=Host(`${AUTH_HOST}`)",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-auth-https.entrypoints=https",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-auth-https.service=leia-${PREVIEW_ENVIRONMENT}-auth",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-auth-https.tls=true",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-auth-https.tls.certresolver=${PREVIEW_CERT_RESOLVER}"
      ],
      "networks": {
        "preview": {
          "aliases": [
            "auth-${PREVIEW_ENVIRONMENT}"
          ]
        },
        "coolify": {}
      },
      "depends_on": {
        "seed": {
          "condition": "service_completed_successfully"
        }
      }
    },
    "designer": {
      "build": {
        "context": "https://github.com/leia-org/leia-designer-backend.git#${DESIGNER_COMMIT}",
        "dockerfile_inline": "FROM node:22-bookworm-slim\nWORKDIR /app\nCOPY . .\nRUN npm ci --omit=dev && npm cache clean --force\nEXPOSE 3000\nCMD [\"node\", \"-e\", \"Object.assign(process.env, JSON.parse(process.env.APP_CONFIG_JSON)); delete process.env.APP_CONFIG_JSON; import('./src/index.js')\"]\n"
      },
      "environment": {
        "APP_CONFIG_JSON": "${DESIGNER_CONFIG_JSON}"
      },
      "restart": "unless-stopped",
      "mem_limit": "384m",
      "cpus": 0.5,
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/', {method:'OPTIONS'}).then(r=>process.exit(r.status===204?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "5s",
        "timeout": "3s",
        "start_period": "20s",
        "retries": 20
      },
      "labels": [
        "traefik.enable=true",
        "traefik.docker.network=coolify",
        "traefik.http.services.leia-${PREVIEW_ENVIRONMENT}-designer.loadbalancer.server.port=3000",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-designer-http.rule=Host(`${DESIGNER_HOST}`)",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-designer-http.entrypoints=http",
        "traefik.http.middlewares.leia-${PREVIEW_ENVIRONMENT}-designer-redirect.redirectscheme.scheme=${PREVIEW_HTTP_SCHEME}",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-designer-http.middlewares=leia-${PREVIEW_ENVIRONMENT}-designer-redirect",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-designer-http.service=leia-${PREVIEW_ENVIRONMENT}-designer",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-designer-https.rule=Host(`${DESIGNER_HOST}`)",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-designer-https.entrypoints=https",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-designer-https.service=leia-${PREVIEW_ENVIRONMENT}-designer",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-designer-https.tls=true",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-designer-https.tls.certresolver=${PREVIEW_CERT_RESOLVER}"
      ],
      "networks": {
        "preview": {
          "aliases": [
            "designer-${PREVIEW_ENVIRONMENT}"
          ]
        },
        "coolify": {}
      },
      "depends_on": {
        "seed": {
          "condition": "service_completed_successfully"
        },
        "auth": {
          "condition": "service_healthy"
        }
      }
    },
    "workbench": {
      "build": {
        "context": "https://github.com/leia-org/leia-workbench-backend.git#${WORKBENCH_COMMIT}",
        "dockerfile_inline": "FROM node:22-bookworm-slim\nWORKDIR /app\nCOPY . .\nRUN npm ci --omit=dev && npm cache clean --force\nEXPOSE 3000\nCMD [\"node\", \"-e\", \"Object.assign(process.env, JSON.parse(process.env.APP_CONFIG_JSON)); delete process.env.APP_CONFIG_JSON; import('./src/index.js')\"]\n"
      },
      "environment": {
        "APP_CONFIG_JSON": "${WORKBENCH_CONFIG_JSON}"
      },
      "restart": "unless-stopped",
      "mem_limit": "384m",
      "cpus": 0.5,
      "healthcheck": {
        "test": [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/', {method:'OPTIONS'}).then(r=>process.exit(r.status===204?0:1)).catch(()=>process.exit(1))"
        ],
        "interval": "5s",
        "timeout": "3s",
        "start_period": "20s",
        "retries": 20
      },
      "labels": [
        "traefik.enable=true",
        "traefik.docker.network=coolify",
        "traefik.http.services.leia-${PREVIEW_ENVIRONMENT}-workbench.loadbalancer.server.port=3000",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-workbench-http.rule=Host(`${WORKBENCH_HOST}`)",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-workbench-http.entrypoints=http",
        "traefik.http.middlewares.leia-${PREVIEW_ENVIRONMENT}-workbench-redirect.redirectscheme.scheme=${PREVIEW_HTTP_SCHEME}",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-workbench-http.middlewares=leia-${PREVIEW_ENVIRONMENT}-workbench-redirect",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-workbench-http.service=leia-${PREVIEW_ENVIRONMENT}-workbench",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-workbench-https.rule=Host(`${WORKBENCH_HOST}`)",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-workbench-https.entrypoints=https",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-workbench-https.service=leia-${PREVIEW_ENVIRONMENT}-workbench",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-workbench-https.tls=true",
        "traefik.http.routers.leia-${PREVIEW_ENVIRONMENT}-workbench-https.tls.certresolver=${PREVIEW_CERT_RESOLVER}"
      ],
      "networks": {
        "preview": {
          "aliases": [
            "workbench-${PREVIEW_ENVIRONMENT}"
          ]
        },
        "coolify": {}
      },
      "depends_on": {
        "seed": {
          "condition": "service_completed_successfully"
        },
        "auth": {
          "condition": "service_healthy"
        }
      }
    }
  },
  "networks": {
    "preview": {},
    "coolify": {
      "external": true
    }
  }
}
