{
  "services": {
    "certificates": {
      "build": {"context": ".", "dockerfile": "previews/Dockerfile.certificates"},
      "environment": {"CF_DNS_API_TOKEN": "${CF_DNS_API_TOKEN}"},
      "volumes": [
        "/data/coolify/proxy/preview-certs:/certs",
        "/data/coolify/proxy/dynamic:/dynamic"
      ],
      "restart": "unless-stopped",
      "mem_limit": "128m",
      "cpus": 0.25,
      "healthcheck": {
        "test": ["CMD-SHELL", "test -s /certs/certificates/leia-preview.crt && test -s /dynamic/leia-preview-tls.yaml"],
        "interval": "30s", "timeout": "3s", "start_period": "180s", "retries": 10
      }
    }
  }
}
