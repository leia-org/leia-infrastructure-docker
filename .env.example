# LEIA Infrastructure Configuration
# Copy this file to .env and update the values as needed

# DATABASE & STORAGE CONFIGURATION (INFRASTRUCTURE)
MONGO_USERNAME=admin
MONGO_PASSWORD=password123
MONGO_PORT=27017
REDIS_PORT=6379
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_BUCKET=leia-images
S3_REGION=auto
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_READ=true

# SERVICE PORTS (HOST)
PORT_AUTH=3005
PORT_DESIGNER_BACKEND=3000
PORT_WORKBENCH_BACKEND=3001
PORT_RUNNER=5002
PORT_DESIGNER_FRONTEND=5173
PORT_WORKBENCH_FRONTEND=8080

# INTERNAL SERVICE URLS (Docker Network)
AUTH_SERVICE_URL=http://auth:80
DESIGNER_BACKEND_URL=http://designer-backend:80
WORKBENCH_BACKEND_URL=http://workbench-backend:80
RUNNER_URL=http://runner:80

# FRONTEND URLS (For CORS and browser access)
DESIGNER_FRONTEND_URL=http://localhost:5173
WORKBENCH_FRONTEND_URL=http://localhost:8080

# SECURITY CONFIGURATION
# Important: Change these secrets in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_KEY=your-api-key-change-this-in-production
RUNNER_KEY=your-runner-key-change-this-in-production
ADMIN_SECRET=your-admin-secret-change-this-in-production
INTERN_TOKEN=your-intern-token-change-this-in-production
API_KEY_STORAGE_SECRET=13af25e58655f106648d94972678da29d6cce43bb40a48f1ed049adcff962be6

# DEFAULT ADMIN USER
DEFAULT_ADMIN_EMAIL=admin@leia.org
DEFAULT_ADMIN_PASSWORD=admin123

# AI / LLM CONFIGURATION
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=
OPENAI_EVALUATION_MODEL=gpt-5.4-mini
DEFAULT_MODEL=openai-responses

# RUNNER SESSIONS
# Segundos que vive una sesión del runner en Redis desde su última actividad (0 = sin caducidad)
SESSION_TTL_SECONDS=86400

# RUNNER OLLAMA PROVIDER
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EVALUATION_MODEL=gemma3:4b
OLLAMA_HISTORY_MAX_MESSAGES=60

# RUNNER ALMA PROVIDER (alma.us.es)
# La API key la introduce cada usuario en la app y se guarda en leia-auth
# Base URL de un modelo de ALMA, la de la API key del usuario tiene prioridad
ALMA_BASE_URL=https://alma.us.es/api/models/llama-3.1-8b-instruct/v1
# Identificador del modelo que se envía a ALMA (el repo de Hugging Face, no el slug)
ALMA_MODEL=meta-llama/Llama-3.1-8B-Instruct
ALMA_MAX_TOKENS=1024
ALMA_EVALUATION_MAX_TOKENS=2048
ALMA_TEMPERATURE=0.7
ALMA_HISTORY_MAX_MESSAGES=60

# CLOUDFLARE TURNSTILE (Optional)
TURNSTILE_ENABLED=false
CLOUDFLARE_SECRET_KEY=

# ENVIRONMENT
NODE_ENV=production
