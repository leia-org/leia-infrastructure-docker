# LEIA Infrastructure Configuration
# Copy this file to .env and update the values as needed

# DATABASE CONFIGURATION
MONGO_USERNAME=admin
MONGO_PASSWORD=password123
MONGO_PORT_DESIGNER=27017
MONGO_PORT_WORKBENCH=27018

# REDIS CONFIGURATION
REDIS_PORT=6379

# SERVICE PORTS
PORT_DESIGNER_BACKEND=3001
PORT_WORKBENCH_BACKEND=3002
PORT_RUNNER=3003
PORT_DESIGNER_FRONTEND=3004
PORT_WORKBENCH_FRONTEND=3005

# SERVICE URLS
RUNNER_URL=http://runner:80

# FRONTEND URLS (for CORS and redirects)
DESIGNER_FRONTEND_URL=http://localhost:3004
WORKBENCH_FRONTEND_URL=http://localhost:3005

# DESIGNER BACKEND
DESIGNER_BACKEND_URL=http://designer-backend:80
DESIGNER_BACKEND_KEY=your-api-key-change-this-in-production

# SECURITY CONFIGURATION
# Can put anything for these values for now (except OPENAI key)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
API_KEY=your-api-key-change-this-in-production
RUNNER_KEY=your-runner-key-change-this-in-production
ADMIN_SECRET=your-admin-secret-change-this-in-production
OPENAI_API_KEY=your-open-ai-api-key

# RUNNER AI MODEL CONFIGURATION
# Provider API keys (OpenAI, Gemini, Ollama, ALMA) are entered by each user in
# the app and resolved per session through the leia-auth service, which this
# stack does not include yet.
OPENAI_EVALUATION_MODEL=gpt-4o
DEFAULT_MODEL=openai-responses
# Seconds a runner session lives in Redis after its last activity (0 = forever)
SESSION_TTL_SECONDS=86400

# RUNNER ALMA PROVIDER (alma.us.es)
# Base URL of one ALMA model; the base URL of the user's API key overrides it
ALMA_BASE_URL=https://alma.us.es/api/models/llama-3.1-8b-instruct/v1
# Model id sent to ALMA (the Hugging Face repo id behind that base URL)
ALMA_MODEL=meta-llama/Llama-3.1-8B-Instruct
ALMA_MAX_TOKENS=1024
ALMA_EVALUATION_MAX_TOKENS=2048
ALMA_TEMPERATURE=0.7
ALMA_HISTORY_MAX_MESSAGES=60

# DEFAULT ADMIN USER
DEFAULT_ADMIN_EMAIL=admin@leia.org
DEFAULT_ADMIN_PASSWORD=admin123

# ENVIRONMENT
NODE_ENV=production
